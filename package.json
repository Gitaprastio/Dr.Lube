{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "npm run build:js -- --mode development && npm run build:css -- --style=expanded --source-map",
    "watch": "webpack --watch --mode development --config webpack.config.js",
    "watch-poll": "npm run watch -- --watch-options-poll",
    "hot": "npm run watch",
    "prod": "npm run production",
    "production": "npm run build:js -- --mode production && npm run build:css -- --style=compressed --no-source-map",
    "build:js": "webpack --config webpack.config.js",
    "build:css": "sass --load-path=node_modules resources/sass/app.scss public/css/app.css"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "bootstrap": "^4.6.2",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "popper.js": "^1.16.1",
    "sass": "^1.101.0",
    "webpack": "^5.108.1",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "axios": "^1.18.1"
  }
}
